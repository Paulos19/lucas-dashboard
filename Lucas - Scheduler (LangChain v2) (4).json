    {
      "parameters": {
        "jsCode": "// ============================================================\n// 4. PARSER PIPE-SPLIT\n// Divide a resposta da IA em múltiplas mensagens usando |\n// Cada segmento será enviado como um balão separado no WhatsApp\n// ============================================================\nconst output = $input.first().json.output || '';\n\n// Remove possíveis artefatos de formatação\nconst cleanOutput = output\n  .replace(/```[\\s\\S]*?```/g, '')  // Remove code blocks\n  .replace(/\\*\\*/g, '')             // Remove bold markdown\n  .trim();\n\n// Divide pelo pipe |\nconst mensagens = cleanOutput\n  .split('|')\n  .map(m => m.trim())\n  .filter(m => m.length > 0);\n\n// Se não houver pipes, envia como mensagem única\nif (mensagens.length === 0) {\n  return [{ json: { texto: cleanOutput || '...', index: 0, total: 1 } }];\n}\n\n// Retorna array de itens para o Split In Batches\nreturn mensagens.map((texto, index) => ({\n  json: {\n    texto: texto,\n    index: index,\n    total: mensagens.length\n  }\n}));"
      },
