    {
      "parameters": {
        "jsCode": "// ============================================================\n// 1. EXTRAIR & NORMALIZAR DADOS DO WEBHOOK (Evolution API)\n// Tratamento robusto de @lid vs @s.whatsapp.net\n// ============================================================\nconst body = $input.first().json.body;\nconst msgData = body.data;\n\n// --- Anti-Loop: ignora mensagens do próprio bot ---\nif (msgData.key.fromMe === true) {\n  return { json: { ignore: true, reason: 'fromMe' } };\n}\n\n// --- Extrair texto da mensagem ---\nconst text = msgData.message?.conversation\n  || msgData.message?.extendedTextMessage?.text\n  || '';\n\n// Ignora mensagens sem texto (stickers, áudio, imagem, etc.)\nif (!text || text.trim().length === 0) {\n  return { json: { ignore: true, reason: 'empty_text' } };\n}\n\n// --- Identificação Normalizada (Correção @lid) ---\n// Prioriza remoteJidAlt que contém o número real @s.whatsapp.net\n// O remoteJid pode vir como @lid (identificador interno do WhatsApp)\nconst remoteJid = msgData.key.remoteJidAlt\n  || body.data?.key?.remoteJidAlt\n  || msgData.key.remoteJid;\n\n// Sender = número da instância do corretor\nconst sender = body.sender || '';\n\n// Telefone da instância (sem caracteres especiais)\nconst instancePhone = sender.replace(/\\D/g, '');\n\nreturn {\n  json: {\n    ignore: false,\n    remoteJid: remoteJid,\n    sender: sender,\n    pushName: msgData.pushName || 'Cliente',\n    text: text.trim(),\n    instance: body.instance,\n    instancePhone: instancePhone\n  }\n};"
      },
