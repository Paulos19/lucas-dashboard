{
  "manifest_version": 3,
  "name": "Lucas CRM Lead Catcher",
  "version": "1.0",
  "description": "Captura screenshots de conversas/perfis e envia para o n8n extrair dados do Lead com IA.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://n8n-n8n.qqfurw.easypanel.host/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capturar Lead"
  },
  "background": {
    "service_worker": "background.js"
  }
}
